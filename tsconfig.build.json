{
  // What the package ships: the source without its tests, emitted as ESM that
  // Node loads as it is, with declarations, and source maps that carry the
  // source so a stack trace points at a real line.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // No ambient types, Node's included: the package runs in browsers and
    // Workers too, so code that reaches for a Node built-in fails the build.
    "types": [],
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
